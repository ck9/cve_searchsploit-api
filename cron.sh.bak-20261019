#!/usr/bin/bash
# cron は最小限の PATH で実行されるため pyenv の python を絶対パスで指定する
set -eu

PYTHON=/root/.pyenv/versions/3.10.11/bin/python
REPO=/root/cve_searchsploit-api

cd "$REPO/cve_searchsploit"
"$PYTHON" main.py -u

cd "$REPO"

cp cve_searchsploit/exploitdb_mapping.json docs/v1/exploitdb_mapping.json
cp cve_searchsploit/exploitdb_mapping_cve.json docs/v1/exploitdb_mapping_cve.json

git add .
if git diff --cached --quiet; then
    echo "no changes"
    exit 0
fi
today=$(date "+%Y/%m/%d %H:%M:%S JST")
git commit -m "update mapping @ $today"
git push
